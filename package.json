{
  "name": "pi-blackhole",
  "version": "0.5.7-omp.1",
  "description": "Unified compaction + observational memory extension for Pi and omp — compresses conversation context while preserving durable observations and reflections",
  "keywords": [
    "agents",
    "ai",
    "blackhole",
    "cli",
    "compact",
    "compaction",
    "observational-memory",
    "oh-my-pi",
    "omp",
    "pi",
    "pi-agent",
    "pi-blackhole",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "recall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockinPaul/pi-blackhole-omp.git"
  },
  "files": [
    "*.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!tests/",
    "tsup.config.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "example-config.json",
    "tests-omp/**/*.ts",
    "README.upstream.md"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt . && oxfmt scripts",
    "format:check": "oxfmt . --check && oxfmt scripts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "verify": "pnpm check && pnpm test",
    "test:omp": "bun test tests-omp/"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "lint-staged": "17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "simple-git-hooks": "^2.14.0",
    "typebox": "1.3.33",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-ai": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.85.1 <1.0.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix"
    ],
    "*.{ts,js,mjs,cjs,json,jsonc,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  }
}
